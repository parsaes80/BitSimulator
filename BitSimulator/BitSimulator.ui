            </property>
            <property name="uniformRowHeights">
             <bool>true</bool>
            </property>
            <property name="sortingEnabled">
             <bool>false</bool>
            </property>
            <column>
             <property name="text">
              <string>Name</string>
             </property>
            </column>
            <column>
             <property name="text">
              <string>Saved</string>
             </property>
            </column>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="savesHint">
            <property name="text">
             <string>Double-click a circuit to open it; right-click it to delete it.</string>
            </property>
            <property name="muted" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
