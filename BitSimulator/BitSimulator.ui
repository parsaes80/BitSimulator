<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>BitSimulatorClass</class>
 <widget class="QMainWindow" name="BitSimulatorClass">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1600</width>
    <height>960</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>BitSimulator</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ==================== BitSimulator theme ====================

   Every color in the app is set in this style sheet, written for dark mode.
   Light mode is made from it: the app swaps each color for the one beside it in the table below.

   To change a color, replace it everywhere below (each color is always spelled the same way, so
   find and replace works) and in its row of the table. A new color needs a new row.

   dark      light     used for
   #0a0e11   #f7f9fa   canvas, scroll bars
   #1e282e   #d3dade   canvas dots
   #0c1013   #ffffff   text fields, HDL editor
   #0f1316   #e9edf0   window, tab bar
   #141a1e   #f2f5f7   panels
   #1b2227   #ffffff   buttons
   #222b31   #eef2f4   button hover
   #12171b   #e2e8eb   button pressed
   #263036   #d5dce0   borders
   #33404a   #b4bfc5   border hover
   #10302d   #d2f2ec   selected tool
   #e4ebee   #1a2328   text
   #7a8890   #5f6e76   muted text
   #4f5b62   #a4afb5   disabled text
   #14b8a6   #14b8a6   teal accent
   #2dd4bf   #0d9488   teal accent hover; wires carrying 1; selection
   #0f9488   #0b7f75   teal accent pressed
   #04211e   #04211e   text on teal
   #e0a526   #e0a526   Pause button (amber)
   #edb740   #edb740   Pause button hover
   #1b1405   #1b1405   text on amber
   #ff9e80   #c2410c   error text
   #141b1f   #ffffff   component bodies, before they are tinted with their outline color
   #c3ced4   #3d4b53   wires while editing; component labels
   #3b4a52   #c3cdd2   wires carrying 0
   #4a5960   #a3b0b6   pins with nothing connected
   #fde68a   #d98a06   wire being drawn, over a pin it can connect to
   #e8b05a   #c4891d   AND, NAND
   #5fd3a5   #13976d   OR, NOR
   #a78bfa   #7c4ddb   XOR, XNOR
   #f27c7c   #d9474b   NOT
   #f59e5b   #dd6f16   multiplexer
   #7aa2f7   #3567d6   register
   #ef4444   #c62828   source
   #67e8f9   #0e8fae   display

   The canvas colors are at the bottom, in the CircuitCanvas rule.
   ============================================================ */

QWidget {
	color: #e4ebee;
	selection-background-color: #14b8a6;
	selection-color: #04211e;
}

QMainWindow, QDialog, QMessageBox {
	background-color: #0f1316;
}

QToolTip {
	background-color: #1b2227;
	color: #e4ebee;
	border: 1px solid #263036;
	border-radius: 4px;
	padding: 4px 6px;
}

QLabel[muted=&quot;true&quot;] {
	color: #7a8890;
}

/* ---------- Tabs ---------- */

QTabWidget::pane {
	border: none;
	border-top: 1px solid #263036;
	background-color: #0f1316;
}

QTabBar {
	background-color: #0f1316;
}

QTabBar::tab {
	background-color: transparent;
	color: #7a8890;
	padding: 7px 16px;
	border: none;
	border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
	color: #e4ebee;
}

QTabBar::tab:selected {
	color: #e4ebee;
	border-bottom: 2px solid #14b8a6;
}

/* ---------- Buttons (the component buttons in the toolbar too) ---------- */

QPushButton {
	background-color: #1b2227;
	color: #e4ebee;
	border: 1px solid #263036;
	border-radius: 6px;
	padding: 5px 10px;
}

QPushButton:hover {
	background-color: #222b31;
	border-color: #33404a;
}

QPushButton:pressed {
	background-color: #12171b;
}

QPushButton:checked {
	background-color: #10302d;
	border: 1px solid #14b8a6;
}

QPushButton:disabled {
	background-color: #141a1e;
	color: #4f5b62;
}

/* Start / Pause: teal while it says Start, amber while it says Pause */
#startButton {
	background-color: #14b8a6;
	border-color: #14b8a6;
	color: #04211e;
	font-weight: bold;
}

#startButton:hover {
	background-color: #2dd4bf;
	border-color: #2dd4bf;
}

#startButton:pressed {
	background-color: #0f9488;
}

#startButton[running=&quot;true&quot;] {
	background-color: #e0a526;
	border-color: #e0a526;
	color: #1b1405;
}

#startButton[running=&quot;true&quot;]:hover {
	background-color: #edb740;
	border-color: #edb740;
}

/* Light / dark mode: a round icon button showing the mode it switches to (the icons are in theme/) */
#themeButton {
	background-color: transparent;
	border: 1px solid transparent;
	border-radius: 18px;
	padding: 0px;
	icon-size: 18px;
	qproperty-icon: url(:/theme/sun.png);
}

#themeButton[scheme=&quot;light&quot;] {
	qproperty-icon: url(:/theme/moon.png);
}

#themeButton:hover {
	background-color: #222b31;
	border-color: #33404a;
}

#themeButton:pressed {
	background-color: #12171b;
}

/* ---------- Speed slider ---------- */

QSlider::groove:horizontal {
	height: 4px;
	background-color: #263036;
	border-radius: 2px;
}

QSlider::sub-page:horizontal {
	background-color: #14b8a6;
	border-radius: 2px;
}

QSlider::handle:horizontal {
	background-color: #e4ebee;
	width: 14px;
	margin: -5px 0;
	border-radius: 7px;
}

QSlider::handle:horizontal:hover {
	background-color: #2dd4bf;
}

/* ---------- Text fields, number boxes, drop-downs ---------- */

QLineEdit, QSpinBox, QComboBox {
	background-color: #0c1013;
	color: #e4ebee;
	border: 1px solid #263036;
	border-radius: 5px;
	padding: 3px 6px;
	min-height: 18px;
}

QLineEdit:hover, QSpinBox:hover, QComboBox:hover {
	border-color: #33404a;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
	border-color: #14b8a6;
}

QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
	color: #4f5b62;
}

/* The text field inside a number box: the number box itself draws the border */
QSpinBox QLineEdit {
	background-color: transparent;
	border: none;
	padding: 0px;
	min-height: 0px;
}

/* The arrow images are in theme/ (theme.qrc) */
QSpinBox::up-button, QSpinBox::down-button {
	subcontrol-origin: border;
	width: 20px;
	border: none;
	background-color: transparent;
}

QSpinBox::up-button {
	subcontrol-position: top right;
}

QSpinBox::down-button {
	subcontrol-position: bottom right;
}

QSpinBox::up-arrow {
	image: url(:/theme/arrow-up.png);
}

QSpinBox::down-arrow, QComboBox::down-arrow {
	image: url(:/theme/arrow-down.png);
}

QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off {
	image: url(:/theme/arrow-up-disabled.png);
}

QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off, QComboBox::down-arrow:disabled {
	image: url(:/theme/arrow-down-disabled.png);
}

QComboBox::drop-down {
	subcontrol-origin: border;
	subcontrol-position: center right;
	width: 22px;
	border: none;
}

QComboBox QAbstractItemView {
	background-color: #141a1e;
	border: 1px solid #263036;
	outline: none;
	padding: 2px;
}

QCheckBox {
	spacing: 8px;
}

QCheckBox::indicator {
	width: 14px;
	height: 14px;
	background-color: #0c1013;
	border: 1px solid #33404a;
	border-radius: 4px;
}

QCheckBox::indicator:hover {
	border-color: #14b8a6;
}

QCheckBox::indicator:checked {
	background-color: #14b8a6;
	border-color: #14b8a6;
	image: url(:/theme/check.png);
}

QCheckBox::indicator:checked:hover {
	background-color: #2dd4bf;
	border-color: #2dd4bf;
}

QCheckBox::indicator:disabled {
	background-color: #141a1e;
	border-color: #263036;
}

QCheckBox:disabled {
	color: #4f5b62;
}

/* ---------- HDL editor ---------- */

QPlainTextEdit {
	background-color: #0c1013;
	color: #e4ebee;
	border: none;
	padding: 6px 8px;
}

/* ---------- Scroll bars ---------- */

QScrollBar:vertical {
	background-color: #0a0e11;
	width: 10px;
	margin: 0;
}

QScrollBar:horizontal {
	background-color: #0a0e11;
	height: 10px;
	margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
	background-color: #263036;
	border-radius: 3px;
	margin: 2px;
}

QScrollBar::handle:vertical {
	min-height: 30px;
}

QScrollBar::handle:horizontal {
	min-width: 30px;
}

QScrollBar::handle:hover {
	background-color: #33404a;
}

QScrollBar::add-line, QScrollBar::sub-line {
	width: 0;
	height: 0;
	border: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
	background: none;
}

QAbstractScrollArea::corner {
	background-color: #0a0e11;
}

/* ---------- Properties panel ---------- */

/* The properties panel floats over the top-right of the canvas in this rounded box */
#propertiesFrame {
	background-color: #141a1e;
	border: 1px solid #263036;
	border-radius: 10px;
}

#propertiesScroll, #propertiesScroll QWidget#qt_scrollarea_viewport, #propertiesPanel {
	background-color: transparent;
}

#propertiesSeparator {
	color: #263036;
}

#propertiesMessage {
	color: #ff9e80;
}

#propertiesLock {
	background-color: #0c1013;
	border: 1px solid #263036;
	border-radius: 6px;
	padding: 8px;
}

/* The joined buttons, e.g. MUX | DEMUX */
#segmented QToolButton {
	padding: 5px 6px;
	background-color: #1b2227;
	color: #e4ebee;
	border: 1px solid #263036;
	border-left-width: 0px;
}

#segmented QToolButton:hover {
	background-color: #222b31;
}

#segmented QToolButton[segment=&quot;first&quot;] {
	border-left-width: 1px;
	border-top-left-radius: 5px;
	border-bottom-left-radius: 5px;
}

#segmented QToolButton[segment=&quot;last&quot;] {
	border-top-right-radius: 5px;
	border-bottom-right-radius: 5px;
}

#segmented QToolButton:checked {
	background-color: #14b8a6;
	border-color: #14b8a6;
	color: #04211e;
	font-weight: bold;
}

#segmented QToolButton:disabled {
	color: #4f5b62;
}

/* The pin buttons of a waveform source: the checked one is the pin the step editor shows */
QToolButton[wavePin=&quot;true&quot;] {
	padding: 3px 0px;
	background-color: #1b2227;
	color: #e4ebee;
	border: 1px solid #263036;
	border-radius: 5px;
}

QToolButton[wavePin=&quot;true&quot;]:hover {
	background-color: #222b31;
}

QToolButton[wavePin=&quot;true&quot;]:checked {
	background-color: #14b8a6;
	border-color: #14b8a6;
	color: #04211e;
	font-weight: bold;
}

/* The numbers of a list source */
#sourceValues {
	background-color: #0c1013;
	border: 1px solid #263036;
	border-radius: 5px;
	padding: 2px 4px;
}

#sourceValues:focus {
	border-color: #14b8a6;
}

/* ---------- Canvas ----------
   The canvas, its components and the toolbar icons are painted in code, which reads these.
   canvasColor and dotColor are the background and its dot grid.
   Components are outlined in their own color, and their body (componentFill) is tinted with it:
   componentTint 0 keeps the plain body, 0.5 goes halfway to the outline color, 1 is the outline color.
   While the simulation runs, a wire carrying 1 is wireHighColor and one carrying 0 is wireLowColor. */

CircuitCanvas {
	border: none;
	background-color: #0a0e11;
	qproperty-canvasColor: #0a0e11;
	qproperty-dotColor: #1e282e;
	qproperty-componentFill: #141b1f;
	qproperty-componentTint: 0.5;
	qproperty-componentText: #c3ced4;
	qproperty-andColor: #e8b05a;
	qproperty-orColor: #5fd3a5;
	qproperty-xorColor: #a78bfa;
	qproperty-notColor: #f27c7c;
	qproperty-muxColor: #f59e5b;
	qproperty-registerColor: #7aa2f7;
	qproperty-sourceColor: #ef4444;
	qproperty-displayColor: #67e8f9;
	qproperty-wireColor: #c3ced4;
	qproperty-wireHighColor: #2dd4bf;
	qproperty-wireLowColor: #3b4a52;
	qproperty-pinColor: #4a5960;
	qproperty-pinWiredColor: #14b8a6;
	qproperty-selectionColor: #2dd4bf;
	qproperty-dragColor: #7a8890;
	qproperty-snapColor: #fde68a;
}</string>
  </property>
