         <number>16</number>
        </property>
        <property name="bottomMargin">
         <number>16</number>
        </property>
        <item>
         <widget class="QLabel" name="hdlEditorHint">
          <property name="text">
           <string>Put your System Verilog, Verilog or VHDL code in the editor. The top module is found automatically.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
          <property name="muted" stdset="0">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPlainTextEdit" name="hdlEditor"/>
        </item>
        <item>
         <layout class="QHBoxLayout" name="hdlEditorButtonRow">
          <item>
           <spacer name="hdlEditorSpacer">
            <property name="orientation">
             <enum>Qt::Orientation::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="compileButton">
            <property name="text">
             <string>Compile</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="CompileDirTab">
       <attribute name="title">
        <string>Compile Dir</string>
       </attribute>
       <layout class="QVBoxLayout" name="compileDirLayout">
        <property name="spacing">
         <number>10</number>
        </property>
        <property name="leftMargin">
         <number>16</number>
        </property>
        <property name="topMargin">
         <number>16</number>
        </property>
        <property name="rightMargin">
         <number>16</number>
        </property>
        <property name="bottomMargin">
         <number>16</number>
        </property>
        <item>
         <widget class="QLabel" name="compileDirHint">
          <property name="text">
           <string>Choose a folder: every Verilog (.v), SystemVerilog (.sv) and VHDL (.vhd, .vhdl) file in it and its subfolders is listed. Uncheck the files to leave out, such as testbenches. The top module is found automatically.</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
          <property name="muted" stdset="0">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="compileDirPathRow">
          <property name="spacing">
           <number>8</number>
          </property>
          <item>
           <widget class="QLineEdit" name="compileDirPath">
            <property name="placeholderText">
             <string>Folder with your Verilog files</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="selectPathButton">
            <property name="text">
             <string>Select path...</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QListWidget" name="compileFilesDisplayer">
          <property name="alternatingRowColors">
           <bool>false</bool>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QHBoxLayout" name="compileDirButtonRow">
          <item>
           <widget class="QLabel" name="compileDirCount">
            <property name="muted" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="compileDirSpacer">
            <property name="orientation">
             <enum>Qt::Orientation::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="compileDirButton">
            <property name="text">
             <string>Compile directory</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
      <widget class="QWidget" name="filesTab">
       <attribute name="title">
        <string>Files</string>
       </attribute>
       <layout class="QHBoxLayout" name="filesLayout" stretch="1,1">
        <property name="spacing">
         <number>24</number>
        </property>
        <property name="leftMargin">
         <number>16</number>
        </property>
        <property name="topMargin">
         <number>16</number>
        </property>
        <property name="rightMargin">
         <number>16</number>
        </property>
        <property name="bottomMargin">
         <number>16</number>
        </property>
        <item>
         <layout class="QVBoxLayout" name="fileActions">
          <property name="spacing">
           <number>10</number>
          </property>
          <item>
           <widget class="QLabel" name="currentFileName">
            <property name="text">
             <string>Untitled</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="currentFilePath">
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="textInteractionFlags">
             <set>Qt::TextInteractionFlag::TextSelectableByMouse</set>
            </property>
            <property name="muted" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QGridLayout" name="fileButtonGrid" columnstretch="0,1">
            <property name="horizontalSpacing">
             <number>14</number>
            </property>
            <property name="verticalSpacing">
             <number>10</number>
            </property>
            <item row="0" column="0">
             <widget class="QPushButton" name="newButton">
              <property name="minimumSize">
               <size>
                <width>130</width>
                <height>40</height>
               </size>
              </property>
              <property name="text">
               <string>New</string>
              </property>
             </widget>
            </item>
            <item row="0" column="1">
             <widget class="QLabel" name="newButtonHint">
              <property name="text">
               <string>Start an empty circuit (Ctrl+N)</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="muted" stdset="0">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="1" column="0">
             <widget class="QPushButton" name="openButton">
              <property name="minimumSize">
               <size>
                <width>130</width>
                <height>40</height>
               </size>
              </property>
              <property name="text">
               <string>Open...</string>
              </property>
             </widget>
            </item>
            <item row="1" column="1">
             <widget class="QLabel" name="openButtonHint">
              <property name="text">
               <string>Open a .bitsim file from anywhere (Ctrl+O)</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="muted" stdset="0">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="2" column="0">
             <widget class="QPushButton" name="saveButton">
              <property name="minimumSize">
               <size>
                <width>130</width>
                <height>40</height>
               </size>
              </property>
              <property name="text">
               <string>Save</string>
              </property>
             </widget>
            </item>
            <item row="2" column="1">
             <widget class="QLabel" name="saveButtonHint">
              <property name="text">
               <string>Save the circuit to its file (Ctrl+S)</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="muted" stdset="0">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item row="3" column="0">
             <widget class="QPushButton" name="saveAsButton">
              <property name="minimumSize">
               <size>
                <width>130</width>
                <height>40</height>
               </size>
              </property>
              <property name="text">
               <string>Save As...</string>
              </property>
             </widget>
            </item>
            <item row="3" column="1">
             <widget class="QLabel" name="saveAsButtonHint">
              <property name="text">
               <string>Save the circuit under a new name in the saves folder (Ctrl+Shift+S)</string>
              </property>
              <property name="wordWrap">
               <bool>true</bool>
              </property>
              <property name="muted" stdset="0">
               <bool>true</bool>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <spacer name="fileActionsSpacer">
            <property name="orientation">
             <enum>Qt::Orientation::Vertical</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>20</width>
              <height>40</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QVBoxLayout" name="savesColumn">
          <property name="spacing">
           <number>8</number>
          </property>
          <item>
           <widget class="QLabel" name="savesTitle">
            <property name="text">
             <string>Saved circuits</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="savesFolder">
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="textInteractionFlags">
             <set>Qt::TextInteractionFlag::TextSelectableByMouse</set>
            </property>
            <property name="muted" stdset="0">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QTreeWidget" name="savesList">
            <property name="rootIsDecorated">
